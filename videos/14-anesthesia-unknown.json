        0.5
      ],
      "seconds": 5.24,
      "text": "Every day, thousands of people are switched off on purpose. Nobody can fully explain how.",
      "delivery": {
        "rate": -4,
        "pitch": -3
      },
      "clips": [
        {
          "src": "videos/14-anesthesia-unknown/v1-1.mp3",
