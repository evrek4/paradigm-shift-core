{
  "title": "They Decoded A Sentence From A Silent Brain",
  "scenes": [
    {
      "image": "videos/18-thought-to-text/G1.jpg",
      "images": [
        "videos/18-thought-to-text/G2.jpg"
      ],
      "imageAt": [
        0,
        0.5
      ],
      "seconds": 6.37,
      "text": "She had not spoken in years. The screen spoke for her at seventy eight words a minute.",
      "delivery": {
        "rate": -4,
        "pitch": -3
      },
      "clips": [
        {
          "src": "videos/18-thought-to-text/v1-1.mp3",
