{
  "title": "The Placebo Works Even When You Know",
  "scenes": [
    {
      "image": "videos/15-open-label-placebo/G1.jpg",
      "images": [
        "videos/15-open-label-placebo/G2.jpg"
      ],
      "imageAt": [
        0,
        0.5
      ],
      "seconds": 5.1,
      "text": "They told patients the pills were fake. The pills worked anyway.",
      "delivery": {
        "rate": -4,
        "pitch": -3
      },
      "clips": [
        {
          "src": "videos/15-open-label-placebo/v1-1.mp3",
