{
  "title": "Dopamine Was Never About Pleasure",
  "scenes": [
    {
      "image": "videos/06-dopamine-is-not-pleasure/1.jpg",
      "seconds": 3.52,
      "text": "Dopamine is not the reward. It is the reaching.",
      "delivery": {
        "rate": -4,
        "pitch": -3
      },
      "clips": [
        {
          "src": "videos/06-dopamine-is-not-pleasure/v1-1.mp3",
          "atMs": 0
