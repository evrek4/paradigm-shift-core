{
  "title": "The Silence Is The Data",
  "scenes": [
    {
      "image": "videos/08-great-filter/1.jpg",
      "seconds": 6.59,
      "text": "The universe is quiet. That silence is the most ominous evidence we have.",
      "delivery": {
        "rate": -4,
        "pitch": -3
      },
      "clips": [
        {
          "src": "videos/08-great-filter/v1-1.mp3",
