{
  "title": "The Internet Is Eating Its Own Tail",
  "scenes": [
    {
      "image": "videos/02-model-collapse/1.jpg",
      "seconds": 3.99,
      "text": "Every AI you use is quietly being poisoned. By itself.",
      "delivery": {
        "rate": -4,
        "pitch": -3
      },
      "clips": [
        {
          "src": "videos/02-model-collapse/v1-1.mp3",
