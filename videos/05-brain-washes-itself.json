{
  "title": "Your Brain Washes Itself While You Sleep",
  "scenes": [
    {
      "image": "videos/05-brain-washes-itself/1.jpg",
      "seconds": 6.15,
      "text": "Sleep is not rest. It is maintenance, and skipping it leaves residue.",
      "delivery": {
        "rate": -4,
        "pitch": -3
      },
      "clips": [
        {
          "src": "videos/05-brain-washes-itself/v1-1.mp3",
